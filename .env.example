# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/remittance_db?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Email Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# Frontend URL
FRONTEND_URL=http://localhost:5174

# Public API URL for push notification images (/uploads/...) — use your LAN IP for physical devices
# PUBLIC_API_URL=http://192.168.1.100:3001

# Firebase Admin (required for device notification center when app is closed)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AML / TMS Provider (LiveEx)
AML_BASE_URL=https://amlhlep.com/TMSSwaggerAPI
# Company / portal credentials from LiveEx (OneZa)
AML_CODE=3004
AML_USERNAME=Admin_OneZa_API
# Quote passwords that contain # or spaces — unquoted # starts a comment in .env
AML_PASSWORD="123@45678#"
AML_REQUEST_TIMEOUT_MS=30000
AML_TOKEN_TTL_SECONDS=3300

# LiveEx Digital Onboarding (face/ID / liveness / OCR)
# Base includes /TMSDigitalOnboardingWeb — login is {BASE}/api/auth/login
LIVEEX_DIGITAL_ONBOARDING_ENABLED=true
LIVEEX_ONBOARD_BASE_URL=https://amlhlep.com/TMSDigitalOnboardingWeb
# Optional overrides (default: reuse AML_CODE / AML_USERNAME / AML_PASSWORD)
# LIVEEX_ONBOARD_COMPANY_CODE=3004
# LIVEEX_ONBOARD_USERNAME=
# LIVEEX_ONBOARD_PASSWORD=
LIVEEX_ONBOARD_TIMEOUT_MS=60000
LIVEEX_ONBOARD_TOKEN_TTL_SECONDS=28000
# Phone signup OTP is static (email OTP still uses LiveEx)
PHONE_OTP_STATIC_CODE=1234
# Base URL for save-website sendUrl (applicant re-request deep link)
# LIVEEX_SEND_URL_BASE=https://your-app.example.com

# Sync each app remittance to POST /api/Transactions/save (default on)
AML_TRANSACTION_SYNC_ENABLED=true
# Pre-send AML gate (default on). When provider is down/pending, locally Approved / LiveEx-verified customers may still send.
# AML_TRANSACTION_GATE_ENABLED=false
# Set true only if LiveEx tenant accepts obj_BNI with bni_ClientNumber (often conflicts with sender client #)
# AML_TRANSACTION_INCLUDE_BENEFICIARY=false

# Ledger tokens
LEDGER_TOKEN_REMITTANCE_INITIATE=
LEDGER_TOKEN_REMITTANCE_COMPLETE=
LEDGER_TOKEN_REMITTANCE_REFUND=

# External BrandPay API
EXTERNAL_API_URL=https://apibrandpay.appliedline.com

# Smarty Address Autocomplete
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
SMARTY_API_KEY=

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Accept.blue Payment Gateway (Basic Auth: API key = username, PIN = password)
# Production: https://api.accept.blue/api/v2
# Sandbox:    https://api.develop.accept.blue/api/v2
ACCEPTBLUE_API_KEY=your_source_key_here
ACCEPTBLUE_PIN=your_pin_here
ACCEPTBLUE_BASE_URL=https://api.develop.accept.blue/api/v2
