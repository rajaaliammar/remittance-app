# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/remittance_db?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Email Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# Frontend URL
FRONTEND_URL=http://localhost:5174

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Ledger tokens
LEDGER_TOKEN_REMITTANCE_INITIATE=
LEDGER_TOKEN_REMITTANCE_COMPLETE=
LEDGER_TOKEN_REMITTANCE_REFUND=

# External BrandPay API
EXTERNAL_API_URL=https://apibrandpay.appliedline.com

# Smarty Address Autocomplete
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
SMARTY_API_KEY=

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Accept.blue Payment Gateway
ACCEPTBLUE_API_KEY=your_api_key_here
ACCEPTBLUE_PIN=your_pin_here
ACCEPTBLUE_BASE_URL=https://api.accept.blue/api/v2
