# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/remittance_db?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Email Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# Frontend URL
FRONTEND_URL=http://localhost:5174

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AML / TMS Provider (LiveEx)
AML_BASE_URL=https://amlhlep.com/UET_TMSSwaggerAPI
AML_CODE=9001
AML_USERNAME=admin_Demo
# Quote passwords that contain # or spaces — unquoted # starts a comment in .env
AML_PASSWORD="your_password_here"
AML_REQUEST_TIMEOUT_MS=30000
AML_TOKEN_TTL_SECONDS=3300
# Sync each app remittance to POST /api/Transactions/save (default on)
AML_TRANSACTION_SYNC_ENABLED=true
# Set true only if LiveEx tenant accepts obj_BNI with bni_ClientNumber (often conflicts with sender client #)
# AML_TRANSACTION_INCLUDE_BENEFICIARY=false

# Ledger tokens
LEDGER_TOKEN_REMITTANCE_INITIATE=
LEDGER_TOKEN_REMITTANCE_COMPLETE=
LEDGER_TOKEN_REMITTANCE_REFUND=

# External BrandPay API
EXTERNAL_API_URL=https://apibrandpay.appliedline.com

# Smarty Address Autocomplete
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
SMARTY_API_KEY=

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Accept.blue Payment Gateway (Basic Auth: API key = username, PIN = password)
# Production: https://api.accept.blue/api/v2
# Sandbox:    https://api.develop.accept.blue/api/v2
ACCEPTBLUE_API_KEY=your_source_key_here
ACCEPTBLUE_PIN=your_pin_here
ACCEPTBLUE_BASE_URL=https://api.develop.accept.blue/api/v2
