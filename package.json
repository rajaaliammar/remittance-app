{
  "name": "remittance-backend",
  "version": "1.0.0",
  "description": "Express backend for remittance application with Prisma",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/prisma-env.js generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/start.js",
    "dev:worker": "node --watch src/workers/start.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres pgbouncer redis",
    "postinstall": "node scripts/prisma-env.js generate",
    "prisma:generate": "node scripts/prisma-env.js generate",
    "prisma:migrate": "node scripts/prisma-env.js migrate dev",
    "prisma:studio": "node scripts/prisma-env.js studio",
    "prisma:seed": "node prisma/seed.js",
    "firebase:setup": "bash ./install-firebase-key.sh",
    "aml:verify": "node scripts/verify-aml.js",
    "migrate:base64-images": "node scripts/migrate-base64-images.js",
    "migrate:base64-images:dry-run": "node scripts/migrate-base64-images.js --dry-run"
  },
  "keywords": [
    "express",
    "prisma",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@prisma/client": "^6.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
