{
  "name": "remittance-backend",
  "version": "1.0.0",
  "description": "Express backend for remittance application with Prisma",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "firebase:setup": "bash ./install-firebase-key.sh",
    "aml:verify": "node scripts/verify-aml.js"
  },
  "keywords": [
    "express",
    "prisma",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
