// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// Example models - customize based on your needs
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model BackofficeUser {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String?   @unique
  firstName       String?
  lastName        String?
  phone           String?
  photo           String?   // URL to uploaded photo
  country         String?
  city            String?
  state           String?
  address         String?
  inviteToken     String    @unique
  inviteTokenExp  DateTime
  status          String    @default("pending") // pending, profile_completed, approved, rejected
  isSuperAdmin    Boolean   @default(false)
  password        String?   // Hashed password
  invitedBy       String?   // Admin who invited
  invitedAt       DateTime  @default(now())
  profileCompletedAt DateTime?
  approvedAt      DateTime?
  approvedBy     String?
  roleId          String?
  role            Role?     @relation(fields: [roleId], references: [id])
  level           String?   // User level (e.g. 1, 2, Bronze, Silver)
  balanceLimit    String?   // Balance limit for the user
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([phone])
  @@map("backoffice_users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  status      String   @default("Active") // Active, Inactive
  permissions Json     // Store permissions as JSON: { moduleName: boolean }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       BackofficeUser[]

  @@map("roles")
}

model Continent {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("Active") // Active, Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  countries Country[]

  @@map("continents")
}

model Country {
  id                    String   @id @default(cuid())
  continentId            String
  continent              Continent @relation(fields: [continentId], references: [id], onDelete: Cascade)
  name                  String
  iso2                  String   @unique
  iso3                  String   @unique
  phoneCode             String
  currencyName           String
  currencyCode           String
  currencyRate           String?
  currencySymbol         String?
  currencyNativeSymbol   String?
  flag                   String?  @db.Text
  isPopular              Boolean  @default(false) // Flagged/favorite - shown in app's popular countries
  status                 String   @default("Active") // Active, Inactive
  sendable               Boolean  @default(false)
  receivable             Boolean  @default(false)
  services               Json?    // Store services as JSON array
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  countryServices        CountryService[]
  countryCharge          CountryCharge?
  states                 State[]
  taxFeeCountries        TaxFeeCountry[]

  @@index([status])
  @@index([continentId])
  @@map("countries")
}

model CountryService {
  id                    String   @id @default(cuid())
  countryId              String
  country                Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name                  String
  serviceType            String   // Airtime, Cash Pick-up, Bank Transfer
  minAmount              String?
  maxAmount              String?
  status                 String   @default("Active") // Active, Inactive
  serviceTypeMode        String   @default("Automatic") // Automatic, Manual
  fields                 Json?    // Store custom fields as JSON array
  remittanceBankId       String?
  remittanceBank         RemittanceBank? @relation(fields: [remittanceBankId], references: [id])
  /// Optional image path (e.g. /uploads/country-services/...) shown in mobile app for this country service
  displayImage           String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("country_services")
}

model CountryCharge {
  id                    String   @id @default(cuid())
  countryId              String   @unique
  country                Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  chargeLevels          Json     // Store charge levels as JSON array: [{ level: number, type: string, amount: string, charge: string }]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("country_charges")
}

model State {
  id                    String   @id @default(cuid())
  countryId              String
  country                Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name                  String
  status                 String   @default("Active") // Active, Inactive
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([countryId, name])
  @@map("states")
}

model Service {
  id                    String   @id @default(cuid())
  name                  String   @unique
  status                 String   @default("Active") // Active, Inactive
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("services")
}

model Purpose {
  id                    String   @id @default(cuid())
  name                  String   @unique
  status                 String   @default("Active") // Active, Inactive
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("purposes")
}

model SourceOfFund {
  id                    String   @id @default(cuid())
  name                  String   @unique
  status                 String   @default("Active") // Active, Inactive
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("source_of_funds")
}

model EmploymentStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employment_statuses")
}

model RemittanceBank {
  id                    String   @id @default(cuid())
  name                  String
  logo                  String?  @db.Text // Base64 encoded logo image
  website               String
  email                 String?
  phoneNumber           String?
  address               String?  @db.Text
  active                Boolean  @default(true)
  dollarRate            String?  // Default dollar/exchange rate for this bank
  assignedCountries     Json?    // Store assigned countries as JSON array: [{ countryCode, country, dollarPrice, status }]
  countryServices       CountryService[]
  giftRules             RemittanceBankGiftRule[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("remittance_banks")
}

model RemittanceBankGiftRule {
  id               String          @id @default(cuid())
  remittanceBankId String
  remittanceBank   RemittanceBank  @relation(fields: [remittanceBankId], references: [id], onDelete: Cascade)

  // Amount range (in send currency USD or destination currency – follow your existing convention)
  minAmount        String
  maxAmount        String
  giftAmount       String          // Gift amount in destination currency
  active           Boolean         @default(true)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("remittance_bank_gift_rules")
}

model RemittanceWallet {
  id                    String   @id @default(cuid())
  name                  String
  logo                  String?  @db.Text // Base64 encoded logo image
  website               String
  email                 String?
  phoneNumber           String?
  address               String?  @db.Text
  active                Boolean  @default(true)
  assignedCountries     Json?    // Store assigned countries as JSON array: [{ countryCode, country, dollarPrice, status }]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("remittance_wallets")
}

model Page {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  content           String?  @db.Text // Rich text content
  sections          Json?    // Store content sections as JSON array: [{ key: string, type: string, name: string }]
  status            String   @default("Draft") // Publish, Draft
  breadcrumbStatus  Boolean  @default(false)
  breadcrumbImage   String?  @db.Text // URL to breadcrumb image
  enPublished       Boolean  @default(false) // English version published
  esPublished       Boolean  @default(false) // Spanish version published
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pages")
}

model ManageContent {
  id                String   @id @default(cuid())
  sectionType       String   @unique // hero, heroTwo, safe, safeTwo, whyChoose, etc.
  englishData       Json     // Store English content as JSON
  spanishData       Json?    // Store Spanish content as JSON (optional)
  images            Json?    // Store image URLs/paths as JSON: { appStoreIcon: string, playStoreIcon: string, etc. }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("manage_content")
}

model BlogCategory {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  blogs             Blog[]

  @@map("blog_categories")
}

model Blog {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  description       String   @db.Text
  descriptionImage  String?  @db.Text // Base64 or URL
  categoryId        String?
  category          BlogCategory? @relation(fields: [categoryId], references: [id])
  status            String   @default("draft") // draft, published
  language          String   @default("english") // english, spanish
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([categoryId])
  @@map("blogs")
}

model Customer {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String?   @unique
  firstName       String?
  middleName      String?
  lastName        String?
  telephone       String?
  phone           String?
  unitApt         String?
  zipCode         String?
  address         String?
  password        String    // Hashed password
  pin             String?   // Hashed PIN (4-digit PIN for mobile app)
  hasPin          Boolean   @default(false) // Flag to indicate if PIN is set
  status          String    @default("pending") // pending, approved, rejected
  approvedAt      DateTime?
  approvedBy      String?
  level           String?   // User level (e.g. 1, 2, Bronze, Silver)
  balanceLimit    String?   // Balance limit for the user
  availableBalance Decimal? @db.Decimal(18, 2) // Wallet balance for remittance; deducted on send
  // Additional profile fields
  dateOfBirth     String?
  gender          String?
  nationality     String?
  placeOfBirth    String?
  occupation      String?
  sourceOfFund    String?
  residentCountry String?
  country         String?
  region          String?
  subRegion       String?
  city            String?
  profileImage    String?   // URL path e.g. /uploads/kyc/profile_image-123.jpg
  // KYC data stored as JSON
  kycData         Json?     // Store KYC documents and details
  kycRequestedAt   DateTime? // When admin requested user to re-upload KYC
  kycRequestedBy   String?   // Admin user ID who requested
  kycRequestedFormId   String?   // KYC form ID from backend (optional)
  kycRequestedFormName String?   // KYC form display name (optional)
  kycRequestedMessage  String?   @db.Text // Optional message from admin
  kycRequestedFields   Json?     // Requested fields: [{ fieldName, inputType, validationType }]
  fcmToken        String?   // FCM device token for push notifications
  lastDeviceInfo  Json?     // Last reported device: { deviceType, brand, model, os, osVersion, userAgent, appVersion }
  lastLocation    Json?     // Last reported location: { latitude, longitude, city, country, region, address }
  lastIpAddress   String?   // Last known client IP address (captured on login/signup/device-report)
  lastSeenAt      DateTime? // When the app last reported device/location
  lastTransactionAt DateTime? // When the customer last completed a transaction (for inactive account detection)
  // Accept.blue payment integration
  acceptblueCustomerId  String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  remittanceTransactions RemittanceTransaction[]
  notifications   CustomerNotification[]
  paymentMethods  PaymentMethod[]
  savedRecipients SavedRecipient[]

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([phone])
  @@index([telephone])
  @@map("customers")
}

model SavedRecipient {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name             String
  accountNumber    String
  phone            String?
  countryId        String?
  countryCode      String?
  countryName      String?
  bankId           String?
  walletId         String?
  serviceProvider  String?
  transferType     String   @default("bank") // bank | wallet | cash
  lastSentAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([customerId])
  @@index([customerId, updatedAt])
  @@map("saved_recipients")
}

model PaymentMethod {
  id                         String    @id @default(cuid())
  customerId                 String
  customer                   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  acceptbluePaymentMethodId  String    @unique
  brand                      String
  last4                      String
  expiryMonth                String
  expiryYear                 String
  holderName                 String?
  isDefault                  Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([customerId])
  @@map("payment_methods")
}

model CustomerNotification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body       String    @db.Text
  imageUrl   String?   @db.Text // Optional image URL for rich notification
  sentAt     DateTime  @default(now())
  readAt     DateTime? // When user viewed it in the app (optional)

  @@index([customerId])
  @@index([customerId, sentAt])
  @@index([customerId, readAt])
  @@map("customer_notifications")
}

model RemittanceTransaction {
  id                  String    @id @default(cuid())
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type                String    @default("Sent") // Sent, Received
  transferType        String?   @default("bank") // bank | wallet - same flow, different label in history
  sendAmount          Decimal   @db.Decimal(18, 2)
  receiveAmount       Decimal   @db.Decimal(18, 2)
  currency            String?
  gatewayId           String?
  gatewayName         String?
  recipientInfo       Json?     // { accountNumber, accountHolderName, serviceProvider, sourceOfFund, sendingPurpose }
  paymentFieldValues  Json?     // Gateway custom field values
  status              String    @default("Processing") // Processing, Completed, Failed, Hold, Manual_Review
  // Compliance fields
  riskScore           Int?      // Computed risk score (0-100+). Higher = riskier.
  triggeredRules      Json?     // Array of rule codes that fired: ["T4", "B2"]
  ipAddress           String?   // Sender IP address at time of transaction
  deviceId            String?   // Sender device ID at time of transaction
  complianceHoldAt    DateTime? // When the transaction was placed on hold
  complianceReviewNote String?  @db.Text // Admin note when resolving
  // Accounting 2 enhancements
  exchangeRate        Decimal?  @db.Decimal(18, 6) // Rate at transaction time
  exchangeRateSource  String?   // Source of exchange rate
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accountingEntries   AccountingEntry[]
  complianceAlerts    ComplianceAlert[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([transferType])
  @@index([type])
  @@map("remittance_transactions")
}

model ComplianceAlert {
  id            String    @id @default(cuid())
  transactionId String
  transaction   RemittanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customerId    String    // Denormalized for fast queries
  ruleCode      String    // e.g. "T4", "B2"
  reason        String    @db.Text
  details       Json?     // Rule-specific match details: { uniqueSenders: 4, amount: 2100 }
  status        String    @default("OPEN") // OPEN, CLOSED
  resolvedBy    String?   // BackofficeUser ID
  resolvedAt    DateTime?
  resolvedNote  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([transactionId])
  @@index([ruleCode])
  @@map("compliance_alerts")
}

model AccountingEntry {
  id                      String   @id @default(cuid())
  entryType               String   // "revenue", "expense", "fee", "commission", "refund"
  category                String?  // e.g., "transaction_fee", "gateway_fee", "operational_cost"
  amount                  Decimal  @db.Decimal(18, 2)
  currency                String   @default("USD")
  description             String?  @db.Text
  referenceType           String?  // "remittance_transaction", "payment", "withdrawal", "manual"
  referenceId             String?  // ID of the referenced transaction
  remittanceTransactionId String?
  remittanceTransaction   RemittanceTransaction? @relation(fields: [remittanceTransactionId], references: [id])
  status                  String   @default("completed") // "pending", "completed", "reversed"
  createdBy               String?  // BackofficeUser ID for manual entries
  // Accounting 2 enhancements
  exchangeRate            Decimal? @db.Decimal(18, 6) // Exchange rate used at transaction time
  exchangeRateGainLoss    Decimal? @db.Decimal(18, 2) // Calculated gain/loss from rate changes
  agentId                 String?  // Link to agent for commission tracking
  agentCommission         Decimal? @db.Decimal(18, 2) // Agent's share
  companyCommission       Decimal? @db.Decimal(18, 2) // Company's share
  walletBalanceBefore     Decimal? @db.Decimal(18, 2) // Wallet balance before transaction
  walletBalanceAfter      Decimal? @db.Decimal(18, 2) // Wallet balance after transaction
  accountId               String?  // Link to chart of accounts
  account                 AccountingAccount? @relation(fields: [accountId], references: [id])
  auditLog                Json?    // Store audit trail data
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([entryType])
  @@index([category])
  @@index([referenceType, referenceId])
  @@index([remittanceTransactionId])
  @@index([createdAt])
  @@index([agentId])
  @@index([accountId])
  @@map("accounting_entries")
}

model AccountingPeriod {
  id              String   @id @default(cuid())
  periodType      String   // "daily", "weekly", "monthly", "yearly"
  periodStart     DateTime
  periodEnd       DateTime
  totalRevenue    Decimal  @db.Decimal(18, 2) @default(0)
  totalExpenses   Decimal  @db.Decimal(18, 2) @default(0)
  totalFees       Decimal  @db.Decimal(18, 2) @default(0)
  netProfit       Decimal  @db.Decimal(18, 2) @default(0)
  currency        String   @default("USD")
  status          String   @default("open") // "open", "closed", "locked"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([periodType, periodStart, periodEnd])
  @@index([periodType])
  @@index([periodStart, periodEnd])
  @@map("accounting_periods")
}

// Accounting 2: Chart of Accounts
model AccountingAccount {
  id          String   @id @default(cuid())
  accountCode String   @unique // e.g., "1000", "2000"
  accountName String
  accountType String   // "asset", "liability", "equity", "revenue", "expense"
  parentId    String?  // For hierarchical accounts
  parent      AccountingAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    AccountingAccount[] @relation("AccountHierarchy")
  status      String   @default("active") // "active", "inactive"
  entries     AccountingEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountType])
  @@index([accountCode])
  @@map("accounting_accounts")
}

// Accounting 2: Audit Log
model AuditLog {
  id              String   @id @default(cuid())
  entityType      String   // "accounting_entry", "transaction", "reconciliation"
  entityId        String
  action          String   // "create", "update", "delete", "reconcile"
  userId          String?  // BackofficeUser or Customer ID
  userType        String?  // "admin", "customer", "system"
  changes         Json?    // Before/after values
  ipAddress       String?
  userAgent       String?
  description     String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Accounting 2: Reconciliation Records
model ReconciliationRecord {
  id                String   @id @default(cuid())
  reconciliationType String  // "bank", "payment_partner", "wallet"
  externalSource    String   // Bank name, partner name, wallet provider
  externalReference String?  // External transaction ID
  internalReference String?  // Internal transaction/entry ID
  amount            Decimal  @db.Decimal(18, 2)
  currency          String
  status            String   @default("pending") // "pending", "matched", "unmatched", "discrepancy"
  discrepancyAmount Decimal? @db.Decimal(18, 2)
  notes             String?  @db.Text
  reconciledAt      DateTime?
  reconciledBy      String? // BackofficeUser ID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([reconciliationType, status])
  @@index([externalReference])
  @@index([internalReference])
  @@map("reconciliation_records")
}

// Accounting 2: Wallet Balance Snapshots
model WalletBalanceSnapshot {
  id              String   @id @default(cuid())
  customerId      String?
  agentId         String?
  balance         Decimal  @db.Decimal(18, 2)
  currency        String
  snapshotType    String   // "daily", "transaction", "reconciliation"
  referenceId     String?  // Transaction or reconciliation ID
  notes           String?   @db.Text
  createdAt       DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([agentId, createdAt])
  @@map("wallet_balance_snapshots")
}

model Agent {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String?   @unique
  firstName       String?
  lastName        String?
  phone           String?
  address         String?
  password        String?   // Hashed password (optional for invited agents)
  status          String    @default("pending") // pending, profile_completed, approved, rejected
  approvedAt      DateTime?
  approvedBy      String?
  level           String?   // User level (e.g. 1, 2, Bronze, Silver)
  balanceLimit    String?   // Balance limit for the user
  // Accounting 2 enhancements
  commissionRate  Decimal?  @db.Decimal(5, 2) // Commission percentage (e.g., 2.5 for 2.5%)
  dollarRate      Decimal?  @db.Decimal(18, 4) // Dollar rate per USD set by agent (e.g., 57.00 or 57.5000)
  totalCommissionEarned Decimal? @db.Decimal(18, 2) // Total commissions earned
  // Invite fields
  inviteToken     String?   @unique
  inviteTokenExp  DateTime?
  invitedBy       String?   // Admin who invited
  invitedAt       DateTime?
  profileCompletedAt DateTime?
  // Additional personal details
  businessName    String?
  country         String?
  city            String?
  gender          String?   // male, female, other
  dateOfBirth     DateTime?
  // Business details
  businessType    String?   // Shop, forex, agent, mobile_shop
  businessLicenseNumber String?
  taxIdentification String? // TIN
  businessAddress String?
  // Document uploads
  idType          String?   // national_id, passport
  nationalIdFront String?   // URL to uploaded file
  nationalIdBack  String?   // URL to uploaded file (only for national ID)
  passportPhoto   String?   // URL to uploaded file (only for passport)
  businessLicenseFile String? // URL to uploaded file
  selfiePhoto     String?   // URL to uploaded file
  shopPhoto       String?   // URL to uploaded file
  // Document status fields (for KYC verification)
  nationalIdFrontStatus String? @default("pending") // pending, approved, rejected
  nationalIdBackStatus  String? @default("pending")
  passportPhotoStatus   String? @default("pending")
  businessLicenseFileStatus String? @default("pending")
  selfiePhotoStatus     String? @default("pending")
  shopPhotoStatus       String? @default("pending")
  // Temporary storage for onboarding data until migration (will be moved to individual fields)
  onboardingData        Json?   // Store onboarding data as JSON temporarily
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([phone])
  @@map("agents")
}

model Menu {
  id              String    @id @default(cuid())
  menuType        String    @unique // header, footer
  items           Json      // Store menu items as JSON: [{ id, name, pageId?, url?, isCustom, order }]
  footerPages     Json?     // For footer: pages section items
  footerUsefulLinks Json?   // For footer: useful links section items
  footerSupportLinks Json?  // For footer: support links section items
  logo            String?   @db.Text // Logo image (base64 or URL) for header menu
  brandName       String?   // Brand name text for header menu
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("menus")
}

model PaymentGateway {
  id                  String    @id @default(cuid())
  name                String
  logo                String?   @db.Text // Base64 encoded logo image or emoji
  logoColor           String?   // Hex color code for logo background
  gatewayCurrencies   Int?      // Number of gateway currencies
  supportedCurrency   Int?      // Number of supported currencies
  description         String?   @db.Text
  status              String    @default("Active") // Active, Inactive
  paymentFields       Json?     // Store payment fields as JSON array
  paymentDescription  String?   @db.Text
  currencyConfigs     Json?     // Store currency configurations as JSON array
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("payment_gateways")
}

model ManualGateway {
  id                  String    @id @default(cuid())
  name                String
  logo                String?   @db.Text // Base64 encoded logo image or emoji
  logoColor           String?   // Hex color code for logo background
  supportedCurrency   Int?      // Number of supported currencies
  description         String?   @db.Text
  status              String    @default("Active") // Active, Inactive
  paymentFields       Json?     // Store payment fields as JSON array
  paymentDescription  String?   @db.Text
  currencyConfigs     Json?     // Store currency configurations as JSON array
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("manual_gateways")
}

model Level {
  id                 String   @id @default(cuid())
  name               String   // e.g. "0", "1", "2"
  priority           Int      // 0, 1, 2, 3...
  description        String?  @db.Text // e.g. "Visitor / Unverified - Phone registered only"
  active             Boolean  @default(true)
  transactionLimits  Json?    // [{ transactionType, perTransaction, dailyAmount, monthlyAmount, dailyCount, maxBalance, currency }]
  kycRequirements    Json?    // { requiredDocuments, description }
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("levels")
}

model KYCForm {
  id              String   @id @default(cuid())
  name            String   // Form name (e.g., "Valid forms of Customer identifications (ID) USD")
  description     String?  @db.Text // Description of the KYC form (e.g., "Required for wallet activation, deposits, and transfers")
  for             String   // "User" or "Merchant"
  status          String   @default("Active") // "Active" or "Inactive"
  countries       Json     // Array of country codes (e.g., ["USD", "CAD"])
  fields          Json     // Array of field objects: [{ id, fieldName, inputType, validationType }]
  priority        Int      @default(1) // Priority/step order (1, 2, 3, 4, 5) - acts as steps
  maxAmount       Decimal? @db.Decimal(18, 2) // Maximum transaction amount allowed after completing this KYC step
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("kyc_forms")
}

model RegistrationSetting {
  id                 String   @id @default(cuid())
  // Profile fields
  phoneNumber        Boolean  @default(true)
  phoneNumberRequired Boolean @default(true)
  emailAddress       Boolean  @default(true)
  emailAddressRequired Boolean @default(false)
  fullName           Boolean  @default(true)
  fullNameRequired   Boolean  @default(true)
  middleName         Boolean  @default(false)
  middleNameRequired Boolean  @default(false)
  telephone          Boolean  @default(false)
  telephoneRequired  Boolean  @default(false)
  unitApt            Boolean  @default(false)
  unitAptRequired    Boolean  @default(false)
  zipCode            Boolean  @default(false)
  zipCodeRequired    Boolean  @default(false)
  dateOfBirth        Boolean  @default(false)
  dateOfBirthRequired Boolean @default(false)
  gender             Boolean  @default(false)
  genderRequired     Boolean  @default(false)
  nationality        Boolean  @default(false)
  nationalityRequired Boolean @default(false)
  placeOfBirth       Boolean  @default(false)
  placeOfBirthRequired Boolean @default(false)
  occupation         Boolean  @default(false)
  occupationRequired Boolean @default(false)
  sourceOfFund       Boolean  @default(false)
  sourceOfFundRequired Boolean @default(false)
  residentCountry    Boolean  @default(false)
  residentCountryRequired Boolean @default(false)
  country            Boolean  @default(false)
  countryRequired    Boolean  @default(false)
  regionState        Boolean  @default(false)
  regionStateRequired Boolean @default(false)
  woredaDistrict     Boolean  @default(false)
  woredaDistrictRequired Boolean @default(false)
  city               Boolean  @default(false)
  cityRequired       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("registration_settings")
}

model Message {
  id          String    @id @default(cuid())
  senderId    String    // Customer id or BackofficeUser id
  recipientId String
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  rating      Int?      // 1-5, set when recipient rates the chat session (for __CHAT_ENDED__ messages)
  ratedAt     DateTime? // When the rating was submitted

  @@index([createdAt])
  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@map("messages")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0) // Display order (lower = first)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

/// In-app legal tabs: privacy, terms, compliance (managed from portal)
model LegalDocument {
  id            String    @id @default(cuid())
  docType       String    @unique // privacy | terms | compliance
  title         String
  sections      Json      // [{ h: string, p: string }]
  effectiveDate DateTime?
  contactEmail  String    @default("legal@onezapay.com")
  status        String    @default("published") // published | draft
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("legal_documents")
}

model TaxFee {
  id          String   @id @default(cuid())
  name        String
  type        String   // "Tax" | "Fee"
  valueType   String   // "percentage" | "fixed" | "dynamic"
  value       Decimal? @db.Decimal(18, 4) // for percentage/fixed: e.g. 5.00 for 5% or 2.50 for fixed; null when dynamic
  tiers       Json?    // for dynamic: [{ minAmount, maxAmount, valueType, value }] - different tax per amount range
  applyTo     String   @default("both") // "bank" | "wallet" | "both" - which transfer channel this applies to
  description String?  @db.Text
  status      String   @default("Active") // Active, Inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  countries   TaxFeeCountry[]

  @@map("tax_fees")
}

model TaxFeeCountry {
  id         String   @id @default(cuid())
  taxFeeId   String
  taxFee     TaxFee   @relation(fields: [taxFeeId], references: [id], onDelete: Cascade)
  countryId  String
  country    Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([taxFeeId, countryId])
  @@map("tax_fee_countries")
}

model OrchestrationJob {
  id                     String    @id @default(cuid())
  type                   String    @default("pre_transaction") // e.g. pre_transaction
  status                 String    @default("pending") // pending, running, completed, failed
  customerId             String?
  context                Json?     // Request context (sendAmount, currency, gatewayId, etc.)
  result                 Json?     // Orchestration result (allowed, message, etc.)
  message                String?   @db.Text // Human-readable message on failure
  remittanceTransactionId String?  // Set after transaction is created
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  events                 OrchestrationEvent[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orchestration_jobs")
}

model OrchestrationEvent {
  id        String   @id @default(cuid())
  jobId     String?
  job       OrchestrationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  eventType String   // e.g. orchestration_started, pre_transaction_check, orchestration_completed
  payload   Json?    // Event-specific data
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([eventType])
  @@index([createdAt])
  @@map("orchestration_events")
}
